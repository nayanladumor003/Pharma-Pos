# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (include the target database name in the path)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pharmapos?appName=<app-name>

# JWT signing secrets (use long random strings — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
